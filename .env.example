# ─────────────────────────────────────────────
# GameVault — Environment Variables
# Copy this file to .env.local and fill values
# ─────────────────────────────────────────────

# PostgreSQL Connection URL (Prisma)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:yourpassword@localhost:5432/gamevault?schema=public"

# RAWG API Key — Get yours at https://rawg.io/apidocs
RAWG_API_KEY="YOUR_API_KEY"

# JWT Secret — Generate a strong random string
# Command: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="your_super_secret_jwt_key_here"

# Next.js Public URL (for absolute URLs in SSR)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
