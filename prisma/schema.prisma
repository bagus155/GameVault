// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────────────────────────
// User Model
// ─────────────────────────────────────────────
model User {
  id        Int      @id @default(autoincrement())
  username  String   @unique
  email     String   @unique
  password  String
  avatarUrl String?
  bannerUrl String?
  bio       String?  @db.VarChar(160)
  createdAt DateTime @default(now())

  reviews   Review[]
  favorites Favorite[]
  topGames  UserTopGame[]

  @@map("users")
}

// ─────────────────────────────────────────────
// Game Model (references RAWG API data)
// id = RAWG game ID stored as String
// ─────────────────────────────────────────────
model Game {
  id        String   @id           // RAWG game ID
  title     String
  slug      String
  coverUrl  String?
  createdAt DateTime @default(now())

  reviews   Review[]
  favorites Favorite[]
  topGames  UserTopGame[]

  @@map("games")
}

// ─────────────────────────────────────────────
// Favorite Model
// ─────────────────────────────────────────────
model Favorite {
  id        Int      @id @default(autoincrement())
  userId    Int
  gameId    String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  game      Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([userId, gameId])
  @@map("favorites")
}

// ─────────────────────────────────────────────
// UserTopGame Model
// Stores up to 5 pinned games per user, ordered by position (1–5)
// ─────────────────────────────────────────────
model UserTopGame {
  id       Int    @id @default(autoincrement())
  userId   Int
  gameId   String
  position Int    // 1–5

  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  game     Game   @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([userId, position])
  @@unique([userId, gameId])
  @@index([userId])            // Fast lookup: user's top games list
  @@map("user_top_games")
}

// ─────────────────────────────────────────────
// Review Model
// ─────────────────────────────────────────────
model Review {
  id        Int      @id @default(autoincrement())
  rating    Int      // 1–5 stars
  comment   String   @db.Text
  userId    Int
  gameId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  game      Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@index([gameId])           // Fast lookup: all reviews for a game
  @@unique([userId, gameId])  // Anti-spam: 1 user can only review 1 game once
  @@map("reviews")
}

